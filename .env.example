# Optional. Die Standardadresse ist https://api.opsucht.net.
OPSUCHT_API_BASE_URL=https://api.opsucht.net

# Optional. Wird bei serverseitigen API-Anfragen gesendet.
OPSUCHT_API_USER_AGENT=OPSUCHT-Economy-Dashboard/1.0 (+community-dashboard)

# Optional. Öffentliche Basis-URL für absolute SEO- und Open-Graph-Metadaten.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional für öffentliche Dashboarddaten, erforderlich für Konten und Cloud-Favoriten.
# Beide Werte sind veröffentlichbare Browserkonfiguration und keine Service-Role-Schlüssel.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
